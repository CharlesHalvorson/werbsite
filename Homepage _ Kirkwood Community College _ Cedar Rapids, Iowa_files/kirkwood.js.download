	    // --- Alumni Directory JS --- 
        function alumniDirectoryFilter(){
            let filterNumber = 0;
            // Show all rows
            $("#alumni_directory div.dirRecord").show();
            // For every checkbox
            // 1. Gather the target(target of being filtered)
            // 2. Gather the checked value (boolean)
            // 3. Gather the data-attr (which critera to judge the boolean against)
            $('input.alumni_dir_filter[type="checkbox"]').each(function(){
                var target = $(this)[0].dataset.target;
                var checked = $(this)[0].checked;
                var attr = $(this)[0].dataset.attr;
                // If this element was checked, hide everything that doesnt have the attr set to true
                if(checked){
                    filterNumber++;
                    $('#'+target+" div.dirRecord:not(" + "\""+ "[data-"+attr+"='true']" + '"'+ ")").hide();
                }
            });
            // Dropdown Filters
            $('select.alumni_dir_filter').each(function(){
                var target = $(this)[0].dataset.target;
                var attr = $(this)[0].dataset.attr;
                var val = $(this).find('option:selected').val();
                // If this element was checked, hide everything that doesnt have the attr set to true
                if(val != ''){
                    filterNumber++;
                    $('#'+target+" div.dirRecord:not(" + "\""+ "[data-"+attr+"='"+val+"']" + '"'+ ")").hide();
                }
            });
            // Search Bar
            var searchVal = $('#alumni_dir_search').val().toLowerCase();
            if(searchVal != '' && searchVal.length >= 3){
                filterNumber++;
                $("#alumni_directory div.paginationPage div.dirRecord div h3.business_name:not([data-business_name*='"+searchVal+"'])").closest('.dirRecord').hide();
            }
            if(filterNumber > 0){
                // hide Pagination menus
                $('#upperPageIndex').hide();
                $('#lowerPageIndex').hide();
                // show all pages
                $('.paginationPage').css('display', 'block');
            } else {
                // show Pagination menus
                $('#upperPageIndex').show();
                $('#lowerPageIndex').show();
                // show all pages
                $('.paginationPage').css('display', 'none');
                let target = $($('a.activePage')[0]).attr('target');
                $('#'+target).css('display', 'block');
            }
        }
        $('input.alumni_dir_filter, select.alumni_dir_filter').change(function(){
            alumniDirectoryFilter();
        });
        $('input.alumni_dir_filter + span.checkmark').click(function(){
            // Only trigger change on 1 element to prevent multiple runs and slow performance
            $('input.alumni_dir_filter:nth-child(1)').trigger('change')
        });
        $('#alumni_dir_search_button').click(alumniDirectoryFilter);
        $('#alumni_dir_search').keyup(function(e){
            if(e.which == 13){
                alumniDirectoryFilter();
            }
        });
        
        $('#reset_alumni_directory_filters').click(function(){
            $('input.alumni_dir_filter[type="checkbox"]:checked').each(function(){
                $(this).trigger('click')
            });
            $('select.alumni_dir_filter').each(function(){
                $(this).val('');
            });
            console.log($('input.alumni_dir_filter[type="checkbox"]')[0].checked);
            $('#alumni_dir_search').val('');
            alumniDirectoryFilter();
        });
         
        
        // --- End Alumni Directory JS ---
		
		function videoSourceUpdate(){
			// Mobile and Desktop Hero Vids
			var mobileSource = $('#heroVideo source').attr('data-mobileSource');
			var mobilePoster = $('#heroVideo').attr('data-mobileposter');
			var desktopSource = $('#heroVideo source').attr('data-source');
			var poster = $('#heroVideo').attr('data-poster');
			
			var video = document.getElementById('heroVideo');
            if(typeof(video) != "undefined" && video != null){
    			// Initializing values
    			var isPlaying = true;
    
    			// On video playing toggle values
    			video.onplaying = function() {
    				isPlaying = true;
    			};
    
    			// On video pause toggle values
    			video.onpause = function() {
    				isPlaying = false;
    			};
    			
    			if($(window).width() < 500){
    				video.pause();
    				$('#heroVideo source').attr('src', mobileSource);
    				video.load();
    				if(video.paused && !isPlaying){
    					video.play();
    				}
    		    } else {
    				video.pause();
    				$('#heroVideo source').attr('src', desktopSource);
    				video.load();
    				if(video.paused && !isPlaying){
    					video.play();
    				}
    		    }
            }
		}
		  videoSourceUpdate();
	    
		$("ul.navbar-nav li div.dropdown-menu").removeClass("show");
		$(".tert-nav a:contains('About Us')").attr('id', 'About_Us_Link');
