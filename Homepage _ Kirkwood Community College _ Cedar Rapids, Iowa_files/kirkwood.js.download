		  $(".so_header").addClass("open");
		  $("#About_Us_Link").html("About Us&nbsp;&nbsp;<span class='fa fa-angle-up' aria-hidden='true'></span>");
		  if($(window).width() < 993){
			  $("#About_Us_Link").html("About Us");
		  }
		  
		}
		
		else if($('.so_header').hasClass("open")) {
		  $(".so_header").removeClass("open");
		  $(".so_header").slideUp(300);
		  $("#About_Us_Link").html("About Us&nbsp;&nbsp;<span class='fa fa-angle-down' aria-hidden='true'></span>");
		  if($(window).width() < 993){
			  $("#About_Us_Link").html("About Us");
		  }
		}
		
	  });
	  //Check this block is open or not..
		$("#About_Us_Link").html("About Us&nbsp;&nbsp;<span class='fa fa-angle-down' aria-hidden='true'></span>");
		if($(window).width() < 993){
			  $("#About_Us_Link").html("About Us");
		  }
	});
	