(function($) {
    
    // ID in Accordion Direct Navigation
    if(window.location.href.includes('#')){
        // Split URL by # and get id
        var id = window.location.href.split('#')[1];
        if(id != ''){
            // If id exists on page and is within an Accordion
            if($('#'+id).length && $('#'+id).closest(".contentWidth[data-parent^='.accordion']").length){
                $('#'+id).closest(".contentWidth[data-parent^='.accordion']").collapse('show');
                $('#'+id).parent().prev('button.accordionProgram').addClass('active');
                setTimeout(function() {
                   $('html, body').animate({
                        scrollTop: $("#"+id).offset().top - 200
                    }, 500); 
                }, 750);
            }
        }
        
    }
    $(document).on('click', '.submit-btn', function(event){
	        var id = $(this).attr('id');
	        var searchInputID = '';
	        if(id = 'search2Submit'){
	            searchInputID = 'searchInput2';
	        } else if(id = 'searchSubmit'){
	            searchInputID = 'searchInput';
	        }
	        var searchText = $('#'+searchInputID).val();
	        if(window.location.href.includes('continuing-education')){
	            event.preventDefault();
	            window.location.href = 'https://www.kirkwood.edu/programs/continuing-education/class-listing?cesearch=' + searchText;
	        }
	        
	    });
	    
	$(document).on('keyup', '#searchInput, #searchInput2', function(event){
        if(event.key === 'Enter'){
            var id = $(this).attr('id');
	        var searchText = $('#'+id).val();
	        if(window.location.href.includes('continuing-education')){
	            event.preventDefault();
	            window.location.href = 'https://www.kirkwood.edu/programs/continuing-education/class-listing?cesearch=' + searchText;
	        }
        }
    });
