":"2f506af8-dfe8-42be-aa26-376deda252e6","name":"PP - AI detection - change source+medium","code":"<script>\nconst aiAgents = [\n{\nname: \"ChatGPT\",\nutmSources: [\"chatgpt\", \"chatgpt.com\"],\nreferrers: [\"chat.openai.com\", \"chatgpt.com\"]\n},\n{\nname: \"Perplexity\",\nutmSources: [\"perplexity\",\"www.perplexity.ai\"],\nreferrers: [\"perplexity.ai\"]\n},\n{\nname: \"Gemini\",\nutmSources: [\"gemini\", \"gemini.google.com\"],\nreferrers: [\"gemini.google.com\"]\n},\n{\nname: \"Copilot\",\nutmSources: [\"bingchat\", \"copilot\", \"copilot.microsoft.com\"],\nreferrers: [\"copilot.microsoft.com\", \"copilot.cloud.microsoft\", \"edgeservices.bing.com\"]\n},\n{\nname: \"Claude\",\nutmSources: [\"claude\"],\nreferrers: [\"claude.ai\"]\n},\n{\nname: \"Poe\",\nutmSources: [\"poe.com\"],\nreferrers: [\"poe.com\"]\n},\n{\nname: \"Meta AI\",\nutmSources: [\"meta_ai\"],\nreferrers: [\"meta.ai\"]\n},\n{\nname: \"You.com\",\nutmSources: [\"youassistant\"],\nreferrers: [\"you.com\"]\n},\n{\nname: \"Mistral\",\nutmSources: [\"chat.mistral.ai\", \"mistral\"],\nreferrers: [\"chat.mistral.ai\"]\n},\n{\nname: \"Qwen\",\nutmSources: [\"chat.qwen.ai\", \"qwen\"],\nreferrers: [\"chat.qwen.ai\"]\n},\n{\nname: \"HuggingChat\",\nutmSources: [\"huggingchat\"],\nreferrers: [\"huggingface.co\", \"huggingchat.com\"]\n}\n];\n \nvar _paq = window._paq || [];\nconst parsedUrl = new URL(document.location.href)\nconst utmSource = parsedUrl.searchParams.get(\"utm_source\");\n \nfor (const agent of aiAgents) {\nif (\n(utmSource && agent.utmSources.includes(utmSource.toLowerCase())) ||\n(document.referrer && agent.referrers.some(r => document.referrer.includes(r)))\n) {\nconst customURL = document.location.origin+document.location.pathname+\"?utm_medium=AI&utm_source=\"+agent.name;\n_paq.push([\"setCustomUrl\", customURL]);\n \n}\n}\n \n</script>","consentType":"not_require_consent","template":"custom_tag","documentWrite":false,"disableInDebugMode":false,"respectVisitorsPrivacy":false,"scheduler