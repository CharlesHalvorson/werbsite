(function(stg,initial){stg=window.sevenTag=stg||{};stg.variables=initial.variables;stg.triggers=initial.triggers;stg.tags=initial.tags;stg.configuration=initial.configuration;stg.consentSettings=initial.consentSettings;stg.consentTemplatesSettings=initial.consentTemplatesSettings;}(window.sevenTag,{"variables":[{"id":"6014a1f7-2c42-40ae-9ec5-63294be37e71","name":"Content Read - Counted Words","type":{"collector_name":"custom_javascript"},"value":"function() {\n  //Hauptelement des Contents selektieren \n  var txt = document.querySelector('.l-main').innerText;\n  var lng = txt.split(\" \").length;\n  return lng;\n}","options":[],"virtual":false,"metaSiteId":"d3a9beca-9513-4215-b846-0afb08655b9c"},{"id":"24ab7e9a-eee0-48cf-b88b-7b3239b2265d","name":"Content Read - Check Scroll Depth","type":{"collector_name":"custom_javascript"},"value":"function () {\n   return window.scrollY >= (document.body.scrollHeight * 0.33);\n}","options":[],"virtual":false,"metaSiteId":"d3a9beca-9513-4215-b846-0afb08655b9c"},{"id":"fb67a1d7-0796-42d8-a39e-809668b53c46","name":"Content Read - Track DL Event","type":{"collector_name":"custom_javascript"},"value":"function () {\n   var eventAlreadySent = {{ Content Read - Event State Sent }};\n\n   if (!eventAlreadySent) {\n      var scrollDepthReached = {{ Content Read - Check Scroll Depth }};\n      var timeSpent = {{ Content Read - Check Time Spent }};\n\n      if (scrollDepthReached && timeSpent) {\n         window.dataLayer = window.dataLayer || [];\n         window.dataLayer.push({\n            'event': 'content_read',\n         });\n         window.contentReadEventSent = true;\n         return true;\n      }\n   }\n   return false;\n}","options":[],"virtual":false,"metaSiteId":"d3a9beca-9513-4215-b846-0afb08655b9c"},{"id":"c04b53a0-fded-41cd-b50a-8b1dd75b8185","name":"Content Read - Check Time Spent","type":{"collector_name":"custom_javascript"},"value":"function () {\n   // Select main element of content \n   var txt = document.querySelector('.l-main').innerText;\n   var lng = txt.split(\" \").length;\n   var l = lng / 300;\n   // Return 300 words/minute reading time or at least 30 seconds\n   lng = (lng == 0) ? 30 : l * 60;\n   // Conversion in milliseconds, only one-third of the words need to be read\n   var requiredTime = Math.round(lng * 1000 / 3);\n\n   // Check timer\n   return performance.now() >= requiredTime;\n}\n","options":[],"virtual":false,"metaSiteId":"d3a9beca-9513-4215-b846-0afb08655b9c"},{"id":"2dd69025-5377-4ecb-90af-cf403d886b0a","name":"Content Read - Event State Sent","type":{"collector_name":"custom_javascript"},"value":"// Piwik Variable: Event Sent State Content Read\nfunction () {\n   // Überprüfen, ob das Event bereits im Data Layer gesendet wurde\n   window.contentReadEventSent = window.dataLayer && window.dataLayer.some(function(event) {\n      return event.event === 'content_read';\n   });\n   return window.contentReadEventSent;\n}\n","options":[],"virtual":false,"metaSiteId":"d3a9beca-9513-4215-b846-0afb08655b9c"},{"id":"73c70131-40ec-47ab-957f-c815af33841e","name":"Click Text Advanced","type":{"collector_name":"custom_javascript"},"value":"function() {\n  \te = window.event;\n   if(e){\n     if(e.target){\n       if(e.target.tagName !== \"BODY\"){\n         return e.target.textContent || e.target.innerText || \"No click text available\";\n       }\n     } \n   }\n}","options":[],"virtual":false,"metaSiteId":"d3a9beca-9513-4215-b846-0afb08655b9c"},{"id":"1505ea6e-46ba-49eb-a2d2-57f2dccafe49","name":"Click Text","type":{"collector_name":"custom_javascript"},"value":"function() {\n  \te = window.event;\n   if(e){\n     if(e.target){\n       if(e.target.tagName !== \"BODY\"){\n         return e.target.textContent || e.target.innerText;\n       }\n     } \n   }\n}","options":[],"virtual":false,"metaSiteId":"d3a9beca-9513-4215-b846-0afb08655b9c"},{"id":"02fe1bac-f419-4b9b-87f1-c41b26fd96a0","name":"PP - DL - visibleElement (Visibility Observer) Tag","type":{"collector_name":"data_layer"},"value":"visibleElement","options":[],"virtual":false,"metaSiteId":"d3a9beca-9513-4215-b846-0afb08655b9c"},{"id":"7ee2dff5-a74e-4ef7-8f76-fb4a3fc44a38","name":"PP - Page Title","type":{"collector_name":"document"},"value":"title","options":[],"virtual":false,"metaSiteId":"d3a9beca-9513-4215-b846-0afb08655b9c"},{"id":"ce9818ed-e76c-4c9f-9a41-d63b27bf4979","name":"PP - JS - FormError","type":{"collector_name":"custom_javascript"},"value":"function() {\n\tvar errcount = document.getElementsByClassName('c-form-error');\n  \tvar message = \"\";\n  if ( errcount.length > 0 ) {\n\tmessage = 'Fehler:';\n\t}\n  else {\n    message = 'Erfolg:';\n  }\n  \n  return message;\n}","options":[],"virtual":false,"metaSiteId":"d3a9beca-9513-4215-b846-0afb08655b9c"},{"id":"934d8e5a-e7ec-4901-baaf-bf7a0f1ee6e6","name":"PP - DL - quiz_name","type":{"collector_name":"data_layer"},"value":"quiz_name","options":[],"virtual":false,"metaSiteId":"d3a9beca-9513-4215-b846-0afb08655b9c"},{"id":"22fb4777-cd44-42c7-8b1c-bf9afad950f1","name":"PP - DL - SiteSearch Query","type":{"collector_name":"data_layer"},"value":"query","options":[],"virtual":false,"metaSiteId":"d3a9beca-9513-4215-b846-0afb08655b9c"},{"id":"a4065607-f382-446a-9c27-9491ae4953ff","name":"GA - JS - TeaserListD Alt-Text","type":{"collector_name":"custom_javascript"},"value":"function() {\n   e = window.event;\n   if (e){\n     if(e.target){\n       var elem = e.target,\n        attr = \"alt\", // change to corresponding attributes\n            result = (elem.getAttribute && elem.getAttribute(attr)) || null;\n\n   // if( !result ) {\n   //     var attrs = elem.attributes,\n   //         l = attrs.length;\n   //     for(var i = 0; i < l; i++) {\n   //        if(attrs[i].nodeName === attr)\n   //             result = attrs[i].nodeValue;\n   //             }\n   // }\n\n    return result;\n         \n       }\n   }\n   \n}","options":[],"virtual":false,"metaSiteId":"d3a9beca-9513-4215-b846-0afb08655b9c"},{"id":"7bd8629d-9c50-4510-a5b3-cab1df43c513","name":"PP - JS - Site Locale","type":{"collector_name":"custom_javascript"},"value":"function() {\n\n  return HARIBO.global.locale;\n\n}","options":[],"virtual":false,"metaSiteId":"d3a9beca-9513-4215-b846-0afb08655b9c"},{"id":"05aa5c5e-a288-4b37-a152-5d225e109cdf","name":"PP - JS - FormName","type":{"collector_name":"custom_javascript"},"value":"function() {\n  \n  if (document.getElementsByClassName('is-active').length === 0) {\n    \n\t\tformname = document.getElementsByTagName('h2')[0].innerText; \n\t}\n  \n\telse {\n        formname = document.getElementsByClassName('is-active')[0].innerText;     \n    }\n  return formname;\n}","options":[],"virtual":false,"metaSiteId":"d3a9beca-9513-4215-b846-0afb08655b9c"},{"id":"252c8423-97c8-422b-8d33-b265024997ef","name":"PP - DL - SiteSearch TotalResults","type":{"collector_name":"data_layer"},"value":"totalResults","options":[],"virtual":false,"metaSiteId":"d3a9beca-9513-4215-b846-0afb08655b9c"},{"id":"b7be7594-fc64-4432-80f5-1e323e29de81","name":"PP - DL - filter_value","type":{"collector_name":"data_layer"},"value":"filter_value","options":[],"virtual":false,"metaSiteId":"d3a9beca-9513-4215-b846-0afb08655b9c"},{"id":"d1e8d4da-a387-49a8-ab13-e1915b614dcc","name":"PP - DL - raffle_name","type":{"collector_name":"data_layer"},"value":"raffle_name","options":[],"virtual":false,"metaSiteId":"d3a9beca-9513-4215-b846-0afb08655b9c"},{"id":"a6da3be3-f3e9-4a0b-a9da-47a8ba723224","name":"PP - JS - Random SessionID","type":{"collector_name":"custom_javascript"},"value":"function () { // Public Domain/MIT\n    var d = new Date().getTime();\n    if (typeof performance !== 'undefined' && typeof performance.now === 'function'){\n        d += performance.now(); //use high-precision timer if available\n    }\n    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {\n        var r = (d + Math.random() * 16) % 16 | 0;\n        d = Math.floor(d / 16);\n        return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);\n    });\n}","options":[],"virtual":false,"metaSiteId":"d3a9beca-9513-4215-b846-0afb08655b9c"},{"id":"cadcb4c2-6120-42ea-8b04-5114a0462cb4","name":"PP - Check if link","type":{"collector_name":"custom_javascript"},"value":"function() {\n  e = window.event;\n   if (e){\n     if(e.target){\n       if(e.target.tagName === \"A\"){\n\t\treturn true;\n         \n       }\n     }\n    }\n}","options":[],"virtual":false,"metaSiteId":"d3a9beca-9513-4215-b846-0afb08655b9c"},{"id":"e22641d0-8070-40ea-8fa2-fe40d88fb75c","name":"PP - Content Group","type":{"collector_name":"custom_javascript"},"value":"function() {\n\nvar products = new RegExp(\"produkte|products|producten|produits|tuotteet|prodotti|produkter|produkty|productos|urunler|produtos|/termekek\");\nvar aboutUs = new RegExp(\"ueber-uns|about-us|over-ons|a-propos-de-nous|entreprise|om-os|tietoa-meista|chi-siamo|om-oss|o-nas|empresa|hakkimizda|/news|/faq|/sobre-nos|/rolunk\");\nvar career = new RegExp(\"karriere|career|carriere|/ura|carriera|kariera|empleo|karriaer|kariyer\");  \nvar activities = new RegExp(\"aktivitaeten|activities|/promotions|activites|giochi-a-premi|/events\"); \nvar other = new RegExp(\"/de-de/|/en/|/en-us/|/en-gb/|en-au/|/nl-nl/|/nl-be/|/fr-be/|/fr-fr/|/de-at/|/de-ch/|/fr-ch/|/da-dk/|/fi-fi/|/it-it/|/nb-no/|/ru-ru/|/es-es/|/sv-se/|/tr-tr/|/pt-pt/|/pt-br/|/ru-ru/|/cs-cz/|/hu-hu/|/pl-pl/|/sk-sk/|/ko-kr/|/ja-jp/|/en-asia/|/en-ca/|/el-gr/|/ar/\"); \nvar home = new RegExp(\"/de|/en|/nl|/fr|/da-dk|/fi-fi|/it-it|/nb-no|/ru-ru|/es-es|/sv-se|/tr-tr|/pt-pt|/pt-br|/ru-ru|/cs-cz|/hu-hu|/pl-pl|/sk-sk|/ko-kr|/ja-jp|/en-asia|/en-ca|/el-gr|/ar\");   \n  \n\nif(products.test(window.location.href)){\n  return 'products';\n}\nelse if(aboutUs.test(window.location.href)){\n  return 'about-us';\n}\nelse if(career.test(window.location.href)){\n  return 'career';\n}  \nelse if(activities.test(window.location.href)){\n  return 'activities';\n}  \nelse if(other.test(window.location.href)){\n  return 'other';\n}    \nelse if(home.test(window.location.href)){\n  return 'home';\n}     \nelse{\n  return 'other';\n}  \n  \n}","options":[],"virtual":false,"metaSiteId":"d3a9beca-9513-4215-b846-0afb08655b9c"},{"id":"4cae9e6b-acf4-4e23-bea2-feccf7b49fe9","name":"PP - JS - FindClosest","type":{"collector_name":"custom_javascript"},"value":"function() {\n  return function(target, selector) {\n    while (!target.matches(selector) && !target.matches('body')) {\n      target = target.parentElement;\n    }\n    return target.matches(selector) ? target : undefined;\n  }\n}","options":[],"virtual":false,"metaSiteId":"d3a9beca-9513-4215-b846-0afb08655b9c"},{"id":"d2513acb-cc67-4a28-ad9a-9712990006a2","name":"PP - DL - filter_type","type":{"collector_name":"data_layer"},"value":"filter_type","options":[],"virtual":false,"metaSiteId":"d3a9beca-9513-4215-b846-0afb08655b9c"},{"id":"18c827bd-43e2-409a-a25d-cd8b0f6b95f7","name":"View within session","type":{"collector_name":"cookie"},"value":"firstVisit","options":[],"virtual":true,"metaSiteId":null},{"id":"6fa9617f-00b8-4bed-8112-ccbb32033c74","name":"External referrer","type":{"collector_name":"url"},"value":"externalReferrer","options":[],"virtual":true,"metaSiteId":null},{"id":"028f3993-dc39-4ad1-8602-f6345c91f3bb","name":"Form Name","type":{"collector_name":"data_layer"},"value":"elementName","options":[],"virtual":true,"metaSiteId":null},{"id":"46505189-34d1-4d98-8418-bd827c3a7c57","name":"CDP Audience","type":{"collector_name":"cdp_audience"},"value":"cdpAudience","options":[],"virtual":true,"metaSiteId":null},{"id":"c98aff1e-a24a-4ab7-bad4-d7e0f056b42e","name":"History state","type":{"collector_name":"data_layer"},"value":"newHistoryState","options":[],"virtual":true,"metaSiteId":null},{"id":"42ff090e-f97c-45b5-8625-21ae26891382","name":"Page Hostname","type":{"collector_name":"url"},"value":"hostname","options":[],"virtual":true,"metaSiteId":null},{"id":"78fec807-3991-4fbc-ad57-238a6960d0b7","name":"Traffic source","type":